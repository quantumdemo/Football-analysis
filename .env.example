# ==============================================================================
# FOOTBALL AI INTELLIGENCE SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit actual secrets, private tokens, or database passwords to Git.
# ==============================================================================

# System Environment Mode ("development", "staging", "production")
ENV=development

# Logging Configuration ("DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL")
LOG_LEVEL=INFO

# Application Server Port
PORT=8000

# Configuration File Path
CONFIG_PATH=config/config.json

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (SUPABASE / POSTGRESQL)
# ------------------------------------------------------------------------------
# Primary database provider ("Supabase" or "PostgreSQL")
DB_TYPE=Supabase

# Supabase Project URL (Public / Server safe)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous API Key (Public - browser/client safe)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_public_anon_key

# Supabase Service Role Key (SERVER-ONLY SECRET - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_secret_key

# Direct PostgreSQL Connection String (Optional / Server-only)
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# SCHEDULER & CRON SECURITY
# ------------------------------------------------------------------------------
# Secret token used to authenticate 6-hour database retention & research cron jobs
CRON_SECRET=your_secure_random_cron_secret_token

# Max API requests per minute for rate limiting
MAX_REQUESTS_PER_MIN=60

# ------------------------------------------------------------------------------
# AI & EXTERNAL SERVICES (OPTIONAL / EXTENSION)
# ------------------------------------------------------------------------------
# OpenAI API Key (Optional server-only secret for contextual text analysis)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
